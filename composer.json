{
    "name": "confluent-digital/vigil",
    "description": "Vigil — suivi de conversion et routeur de postback",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "bacon/bacon-qr-code": "^3.0",
        "monolog/monolog": "^3.6",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.13",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}