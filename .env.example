# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Vigil
APP_DEBUG=1
TZ=UTC
# Base publique des liens de tracking et de postback.
#
# C'est cette valeur, et non l'adresse consultee, qui prefixe les liens : un
# lien de tracking est un objet PUBLIC qu'un publisher colle dans ses e-mails.
# Le deduire du navigateur ferait copier « http://127.0.0.1:388/c/... » a un
# administrateur, qui le transmettrait tel quel.
#
#   developpement : http://dev.vigil.confluent-digital.com   (convention du parc,
#                   entree /etc/hosts vers 127.0.0.1, HTTP — pas de certificat)
#   production    : https://vigil.confluent-digital.com
#
# Le back-office signale l'ecart si la valeur ne correspond pas au domaine
# consulte : c'est le symptome d'un lien affiche qui ne fonctionnera pas.
APP_URL=http://dev.vigil.confluent-digital.com

# ─── Base de donnees (MariaDB 10.11 LTS) ────────────────────────────────────
DB_HOST=vigil_database
DB_PORT=3306
DB_NAME=bd_vigil
DB_USERNAME=vigil
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_CHARSET=utf8mb4

# ─── Redis (buffer de clics + cache campagnes) ──────────────────────────────
# BUFFER=0 : ecriture synchrone en base (defaut, simple).
# BUFFER=1 : les clics sont empiles dans Redis et inseres par lots par le worker.
REDIS_HOST=vigil_redis
REDIS_PORT=6379
CLICK_BUFFER_ENABLED=0

# ─── Secrets ────────────────────────────────────────────────────────────────
# Cle de signature des postbacks entrants (HMAC-SHA256). openssl rand -hex 32
POSTBACK_SECRET=
# Cle de session du back-office. openssl rand -hex 32
APP_SECRET=

# ─── Docker (ports exposes sur 127.0.0.1 uniquement) ────────────────────────
DOCKER_NGINX_PORT=388
DOCKER_PHP_PORT=988
DOCKER_MYSQL_PORT=3311
DOCKER_REDIS_PORT=6391
DOCKER_DB_DIRECTORY=./.docker-data/mariadb
DOCKER_WORKING_DIR=/data/www/vigil.confluent-digital.com
UID=1000
GID=1000

# ─── Envoi de courriel (repli du second facteur) ────────────────────────────
# En dev, MailHog : MAIL_HOST=vigil_mailhog, MAIL_PORT=1025, pas d'auth.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PWD=
MAIL_ENCRYPTION=
MAIL_FROM=vigil@confluent-digital.com
MAIL_FROM_NAME=Vigil

# ─── Second facteur ─────────────────────────────────────────────────────────
# Emetteur affiche dans l'application d'authentification.
TOTP_ISSUER=Vigil
DOCKER_MAILHOG_SMTP_PORT=1029
DOCKER_MAILHOG_HTTP_PORT=8029

# Adresse visee par la suite de tests HTTP (vue depuis le conteneur PHP).
TEST_BASE_URL=http://vigil_nginx

# Cache Twig compile (production uniquement). Par defaut dans le conteneur :
# du PHP regenerable, qui n' a rien a faire sur un volume monte.
TWIG_CACHE_DIR=
