<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Rapides, sans base : la logique pure. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Base de test dediee, chaque test en transaction annulee. -->
        <testsuite name="feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Le chemin chaud, exerce par HTTP : c'est le seul moyen fidele de
             verifier un code 302, un en-tete ou un fastcgi_finish_request. -->
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
