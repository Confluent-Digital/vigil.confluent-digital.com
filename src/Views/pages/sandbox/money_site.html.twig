{% extends 'layouts/base.html.twig' %}
{% block title %}Faux money site{% endblock %}
{% block content %}

<div class="alert alert-info d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-shop fs-4"></i>
    <div>
        <strong>Vous êtes sur le faux money site.</strong> Cette page affiche exactement ce que
        Vigil lui a transmis. En validant, elle appellera <code>/pb</code> côté serveur,
        comme le ferait un vrai annonceur.
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 fw-semibold">Ce que la page a reçu</div>
            <div class="card-body">
                <p class="mb-2">
                    <span class="text-muted small">clickid</span><br>
                    {% if clickid_valide %}
                        <code>{{ clickid }}</code>
                        <span class="badge text-bg-success">ULID valide</span>
                    {% else %}
                        <span class="badge text-bg-danger">absent ou invalide</span>
                    {% endif %}
                </p>

                <p class="text-muted small mb-1">Pré-remplissage</p>
                {% if prefill %}
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                            {% for cle, libelle in champs %}
                                <tr>
                                    <td class="text-muted" style="width:8rem"><code>{{ cle }}</code></td>
                                    <td>{{ prefill[cle]|default('—') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        Ces valeurs ont traversé Vigil sans y être écrites — vérifiez-le dans
                        <a href="/app/clicks">la liste des clics</a>.
                    </p>
                {% else %}
                    <p class="text-muted mb-0">Aucun champ de pré-remplissage reçu.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header py-2 fw-semibold">Simuler la validation de commande</div>
            <div class="card-body">
                <form method="post" action="/sandbox/money-site/convert">
                    <input type="hidden" name="csrf" value="{{ csrf_token }}">
                    <input type="hidden" name="clickid" value="{{ clickid }}">

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label" for="txid">Identifiant de transaction</label>
                            <input class="form-control font-monospace" id="txid" name="txid" value="{{ txid_suggere }}">
                            <div class="form-text">Videz-le pour voir le mode dégradé.</div>
                        </div>
                        <div class="col-3">
                            <label class="form-label" for="payout">Montant</label>
                            <input class="form-control" id="payout" name="payout" value="12.50">
                        </div>
                        <div class="col-3">
                            <label class="form-label" for="status">Statut</label>
                            <select class="form-select" id="status" name="status">
                                {% for s in ['approved', 'pending', 'rejected', 'chargeback'] %}
                                    <option value="{{ s }}">{{ s }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="secret">Secret de postback</label>
                            <input class="form-control font-monospace" id="secret" name="secret" value="{{ secret }}">
                            <div class="form-text">Modifiez-le pour vérifier que la conversion est refusée.</div>
                        </div>
                    </div>

                    <button class="btn btn-primary w-100" type="submit"
                            {{ clickid_valide ? '' : 'disabled' }}>
                        <i class="bi bi-cash-coin"></i> Valider la commande et envoyer le postback
                    </button>
                </form>
                <a class="btn btn-link btn-sm w-100 mt-2" href="/sandbox">Retour au bac à sable</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
