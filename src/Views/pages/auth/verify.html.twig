{% extends 'layouts/base.html.twig' %}
{% block title %}Vérification{% endblock %}
{% block content %}
<div class="login">
    <div class="login-brand">
        <span class="brand-mark"><i class="bi bi-shield-check"></i></span>
        <div class="login-name">Vérification</div>
        <p class="login-tagline">{{ user_email }}</p>
    </div>

    <div class="card">
        <div class="card-body">
            {% if error %}<div class="alert alert-danger py-2 mb-3"><i class="bi bi-exclamation-triangle"></i> {{ error }}</div>{% endif %}

            <form method="post" action="/login/verify">
                <input type="hidden" name="csrf" value="{{ csrf_token }}">
                <label class="form-label" for="code">
                    {% if code_sent %}Code de votre application ou reçu par courriel{% else %}Code de votre application{% endif %}
                </label>
                <input class="form-control code-input mb-3" id="code" name="code" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="12" placeholder="000000" required autofocus>
                <button class="btn btn-primary w-100" type="submit">Vérifier</button>
            </form>

            <hr class="my-3">

            <div class="d-grid gap-2">
                {% if can_send_mail %}
                <form method="post" action="/login/email-code">
                    <input type="hidden" name="csrf" value="{{ csrf_token }}">
                    <button class="btn btn-outline-secondary btn-sm w-100" type="submit">
                        <i class="bi bi-envelope"></i>
                        {{ code_sent ? 'Renvoyer un code par courriel' : 'Recevoir un code par courriel' }}
                    </button>
                </form>
                {% else %}
                    <p class="small text-muted mb-0 text-center">
                        Trop de codes demandés par courriel. Patientez une heure, ou utilisez un code de secours.
                    </p>
                {% endif %}
                <p class="small text-muted mb-0 text-center">
                    Téléphone perdu ? Saisissez l'un de vos <strong>codes de secours</strong>
                    dans le champ ci-dessus.
                </p>
            </div>
        </div>
    </div>

    <p class="text-center mt-3">
        <a class="small text-muted" href="/logout">Annuler et revenir à la connexion</a>
    </p>
</div>
{% endblock %}
