{% extends 'layouts/base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block content %}
<div class="login">
    <div class="login-brand">
        <span class="brand-mark"><i class="bi bi-broadcast"></i></span>
        <div class="login-name">{{ app_name }}</div>
        <p class="login-tagline">Tracker de clics et routeur de postback</p>
    </div>

    <div class="card">
        <div class="card-body">
            {% if error %}<div class="alert alert-danger py-2 mb-3"><i class="bi bi-exclamation-triangle"></i> {{ error }}</div>{% endif %}
            <form method="post" action="/login">
                <input type="hidden" name="csrf" value="{{ csrf_token }}">
                <div class="mb-3">
                    <label class="form-label" for="email">E-mail</label>
                    <input class="form-control" type="email" id="email" name="email"
                           autocomplete="username" placeholder="vous@exemple.com"
                           value="{{ email|default('') }}" required autofocus>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="password">Mot de passe</label>
                    <input class="form-control" type="password" id="password" name="password"
                           autocomplete="current-password" required>
                </div>
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-box-arrow-in-right"></i> Se connecter
                </button>
            </form>
        </div>
    </div>

    <p class="login-foot">
        Accès réservé · heures affichées en Europe/Paris, données stockées en UTC
    </p>
</div>
{% endblock %}
