{% extends 'layouts/base.html.twig' %}
{% block title %}{{ campaign.campaign_name }}{% endblock %}
{% block content %}
<div class="page-head">
    <div>
        <div class="page-sub"><a href="/app/campaigns" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Campagnes</a></div>
        <h1 class="page-title mb-1">{{ campaign.campaign_name }}</h1>
        <div class="page-sub">
            {{ campaign.client_name }} ·
            <span class="badge text-bg-{{ campaign.campaign_status == 'active' ? 'success' : 'warning' }}">{{ campaign.campaign_status }}</span> ·
            payout par défaut <span class="num fw-semibold">{{ campaign.campaign_payout|money(campaign.campaign_currency) }}</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary btn-sm" href="/app/campaigns/{{ campaign.campaign_id }}/edit">
            <i class="bi bi-pencil"></i> Modifier</a>
    </div>
</div>

{% include 'partials/_url_ecart.html.twig' %}
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-box-arrow-up-right"></i> Destination</div>
    <div class="card-body">
        <code class="d-block text-break">{{ campaign.campaign_dest_url }}</code>
        <div class="form-text">Les macros sont résolues au moment du clic, chaque valeur étant encodée.</div>
    </div>
</div>

{# ── Postback entrant : l'URL a donner au client ───────────────────────── #}
{% set pb_secret = campaign.campaign_postback_secret|default('') %}
{% set pb_url = base_url ~ '/pb?clickid=CLICKID&amount=MONTANT&txid=TXID'
                ~ (pb_secret ? '&s=' ~ pb_secret : '') %}
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-arrow-return-left"></i> Postback entrant — l'URL à donner au client</div>
    <div class="card-body">

        <p class="text-muted small mb-2">
            C'est le <strong>seul</strong> postback que le client configure chez lui, quel que soit
            le nombre de campagnes qui pointent vers son money site. Vigil reconnaît la campagne
            grâce au <code>clickid</code>, puis relaie vers les destinations ci-dessous.
        </p>

        <div class="input-group input-group-sm mb-2">
            <input class="form-control font-monospace" readonly value="{{ pb_url }}"
                   aria-label="URL de postback de la campagne">
            <button class="btn btn-outline-secondary copy-btn" type="button" data-copy="{{ pb_url }}"
                    title="Copier l'URL" aria-label="Copier l'URL"><i class="bi bi-clipboard"></i></button>
        </div>

        <p class="small mb-3">
            <code>CLICKID</code> et <code>TXID</code> sont à remplacer par les variables
            <strong>du money site</strong>, pas par des macros Vigil : il substitue les siennes
            avant de nous appeler.
        </p>

        {% if '{clickid}' not in campaign.campaign_dest_url|default('') %}
        <div class="alert alert-danger d-flex align-items-start gap-2 py-2 small mb-3">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <div>
                <strong>La destination ne transmet pas <code>{clickid}</code>.</strong>
                Le money site n'aura donc rien à nous renvoyer, et aucun postback ne pourra être
                rattaché à un clic. Ajoutez la macro à l'URL de destination.
            </div>
        </div>
        {% endif %}

        {% if not pb_secret %}
        <div class="alert alert-warning d-flex align-items-start gap-2 py-2 small mb-3">
            <i class="bi bi-shield-exclamation"></i>
            <div>
                <strong>Aucun secret partagé.</strong> N'importe qui connaissant un
                <code>clickid</code> peut créer une conversion — qui sera relayée et facturée.
                <a href="/app/campaigns/{{ campaign.campaign_id }}/edit">En définir un</a>.
            </div>
        </div>
        {% endif %}

        <div class="table-responsive">
        <table class="table table-sm align-middle mb-2">
            <thead><tr><th>Paramètre</th><th>Obligatoire</th><th>Rôle</th></tr></thead>
            <tbody class="small">
                <tr>
                    <td class="font-monospace">clickid</td>
                    <td><span class="badge text-bg-danger">oui</span></td>
                    <td>L'identifiant que Vigil a transmis au money site lors de la redirection.
                        Alias acceptés : <code>click_id</code>, <code>cid</code>.</td>
                </tr>
                <tr>
                    <td class="font-monospace">s</td>
                    <td>{% if pb_secret %}<span class="badge text-bg-danger">oui</span>{% else %}<span class="badge text-bg-secondary">non défini</span>{% endif %}</td>
                    <td>Le secret partagé. Sans lui, la conversion est <strong>refusée</strong> —
                        mais Vigil répond quand même <code>{{ campaign.campaign_postback_response|default('OK') }}</code>,
                        donc le branchement a l'air réussi. Les refus sont listés sur
                        <a href="/app/dead-links">Liens morts</a>. Alias : <code>secret</code>.</td>
                </tr>
                <tr>
                    <td class="font-monospace">txid</td>
                    <td><span class="badge text-bg-warning">fortement conseillé</span></td>
                    <td>La référence de transaction du client. C'est elle qui rend l'appel
                        idempotent : cinq envois du même <code>txid</code> ne font qu'une
                        conversion. Sans elle, on retombe sur une conversion par clic — donc
                        une seule vente possible par visiteur. Alias :
                        <code>transaction_id</code>, <code>order_id</code>.</td>
                </tr>
                <tr>
                    <td class="font-monospace">status</td>
                    <td><span class="badge text-bg-secondary">non</span></td>
                    <td><code>approved</code> par défaut. Aussi : <code>pending</code>,
                        <code>rejected</code>, <code>chargeback</code>. Un second appel avec un
                        statut différent met la conversion à jour et redéclenche le relai.</td>
                </tr>
                <tr>
                    <td class="font-monospace">payout</td>
                    <td><span class="badge text-bg-secondary">non</span></td>
                    <td>Montant de la conversion. Alias <code>amount</code>, le nom employé par
                        les money sites branchés sur la plateforme externe. À défaut, le payout
                        de la campagne ({{ campaign.campaign_payout|money(campaign.campaign_currency) }}).</td>
                </tr>
                <tr>
                    <td class="font-monospace">revenue</td>
                    <td><span class="badge text-bg-secondary">non</span></td>
                    <td>Chiffre d'affaires côté client, pour la marge. <code>0</code> par défaut.</td>
                </tr>
            </tbody>
        </table>
        </div>

        <p class="text-muted small mb-0">
            <code>GET</code> ou <code>POST</code>, les deux sont acceptés. La réponse est
            <strong>toujours</strong> <code>200</code>, y compris en cas de refus : un money site
            qui verrait une erreur retenterait, ou couperait le tunnel de paiement.
            {% if campaign.campaign_postback_ips %}
            Appels restreints aux IP <code>{{ campaign.campaign_postback_ips }}</code>.
            {% endif %}
        </p>
    </div>
</div>

{# ── Liens publishers ──────────────────────────────────────────────────── #}
<div class="card mb-3 card-table">
    <div class="card-header justify-content-between">
        <span><i class="bi bi-link-45deg"></i> Liens publishers</span>
        <button class="btn btn-primary btn-xs" data-bs-toggle="collapse" data-bs-target="#addAccess">
            <i class="bi bi-plus-lg"></i> Donner accès</button>
    </div>

    <div class="collapse {{ access is empty ? 'show' }}" id="addAccess">
        <div class="card-body border-bottom bg-body-tertiary">
            {% if available %}
            <form method="post" action="/app/campaigns/{{ campaign.campaign_id }}/access" class="row g-2 align-items-end">
                <input type="hidden" name="csrf" value="{{ csrf_token }}">
                <div class="col-md-5">
                    <label class="form-label" for="publisher_id">Publisher</label>
                    <select class="form-select" id="publisher_id" name="publisher_id" required>
                        {% for p in available %}<option value="{{ p.publisher_id }}">{{ p.publisher_name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="cp_payout">Payout spécifique</label>
                    <input class="form-control text-end num" id="cp_payout" name="cp_payout" placeholder="défaut campagne">
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-link-45deg"></i> Créer le lien</button>
                </div>
            </form>
            {% else %}
                <p class="text-muted mb-0">Tous les publishers actifs ont déjà un accès à cette campagne.</p>
            {% endif %}
        </div>
    </div>

    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead><tr><th>Publisher</th><th>Lien de tracking</th><th class="text-end">Payout</th><th>Statut</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        {% for a in access %}
            <tr>
                <td class="fw-semibold">{{ a.publisher_name }}</td>
                <td>
                    {% set link = base_url ~ '/c/' ~ a.cp_token %}
                    <div class="input-group input-group-sm">
                        <input class="form-control font-monospace" readonly value="{{ link }}"
                               aria-label="Lien de tracking de {{ a.publisher_name }}">
                        <button class="btn btn-outline-secondary copy-btn" type="button" data-copy="{{ link }}"
                                title="Copier le lien nu" aria-label="Copier le lien"><i class="bi bi-clipboard"></i></button>
                        <button class="btn btn-outline-secondary gen-btn" type="button"
                                data-lien="{{ link }}" data-publisher="{{ a.publisher_name }}"
                                data-bs-toggle="modal" data-bs-target="#genLien"
                                title="Composer le lien avec ses paramètres"
                                aria-label="Composer le lien"><i class="bi bi-sliders"></i></button>
                    </div>
                </td>
                <td class="text-end">{{ a.cp_payout ? a.cp_payout|money(campaign.campaign_currency) : '—' }}</td>
                <td>
                    <span class="badge text-bg-{{ a.cp_status == 'active' ? 'success' : 'warning' }}">{{ a.cp_status }}</span>
                    {% if a.publisher_status != 'active' %}
                        <span class="badge text-bg-secondary" title="Le publisher lui-même est {{ a.publisher_status }} : le lien ne redirige pas.">publisher {{ a.publisher_status }}</span>
                    {% endif %}
                </td>
                <td class="text-end text-nowrap">
                    <form method="post" action="/app/campaigns/{{ campaign.campaign_id }}/access/{{ a.cp_id }}/toggle" class="d-inline">
                        <input type="hidden" name="csrf" value="{{ csrf_token }}">
                        <button class="btn btn-outline-secondary btn-xs" type="submit">{{ a.cp_status == 'active' ? 'Suspendre' : 'Activer' }}</button>
                    </form>
                    <form method="post" action="/app/campaigns/{{ campaign.campaign_id }}/access/{{ a.cp_id }}/regenerate" class="d-inline"
                          onsubmit="return confirm('Régénérer le token ? Le lien actuellement en circulation cessera de fonctionner et ses clics tomberont en 404.')">
                        <input type="hidden" name="csrf" value="{{ csrf_token }}">
                        <button class="btn btn-outline-danger btn-xs" type="submit" title="À n'utiliser que si le lien a fuité">Régénérer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">
                {% include 'partials/_empty.html.twig' with {
                    'icon': 'link-45deg',
                    'title': 'Aucun lien de tracking',
                    'text': "Un publisher ne peut pas fabriquer de lien lui-même : c'est ici qu'on le crée, en lui donnant accès à cette campagne. Sans lien en circulation, aucun clic ne sera enregistré."
                } only %}
            </td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {% if access is not empty %}
    <div class="card-body border-top small">
        <a class="text-decoration-none" data-bs-toggle="collapse" href="#paramsLien" role="button"
           aria-expanded="false" aria-controls="paramsLien">
            <i class="bi bi-chevron-right"></i> Ce que le publisher peut ajouter au lien
        </a>
        <div class="collapse" id="paramsLien">
            <p class="text-muted mt-2 mb-2">
                Le lien fonctionne tel quel : le token porte déjà le couple campagne × publisher.
                Ces paramètres sont facultatifs, et se collent à la suite.
            </p>
            <div class="table-responsive">
            <table class="table table-sm align-middle mb-2">
                <thead><tr><th>Paramètre</th><th>Rôle</th></tr></thead>
                <tbody>
                    <tr>
                        <td class="font-monospace">cid</td>
                        <td>Son propre identifiant de clic, celui qu'il veut voir revenir sur son
                            pixel de conversion. <strong>C'est le paramètre qui compte</strong> :
                            sans lui, on peut lui signaler une conversion, mais pas lui dire
                            laquelle. Alias : <code>clickid</code>, <code>click_id</code>,
                            <code>subid</code>, <code>sub_id</code>, <code>ext_id</code>,
                            <code>transaction_id</code>.</td>
                    </tr>
                    <tr>
                        <td class="font-monospace">s1 … s5</td>
                        <td>Cinq valeurs libres qu'il choisit (source, créa, liste…), restituées
                            telles quelles dans le reporting et relayables par macro. Alias :
                            <code>sub1</code> … <code>sub5</code>.</td>
                    </tr>
                    <tr>
                        <td class="font-monospace">nom, prenom, email…</td>
                        <td>Les douze champs du kit mailing, transmis au money site pour
                            pré-remplir son formulaire. Ils <strong>ne sont jamais enregistrés</strong> :
                            ni en base, ni dans les journaux, ni dans le <code>Referer</code>.</td>
                    </tr>
                </tbody>
            </table>
            </div>
            <p class="text-muted mb-0">
                Exemple :
                <code class="text-break">{{ base_url }}/c/{{ access|first.cp_token }}?cid=SON_CLICKID&amp;s1=newsletter</code>
            </p>
        </div>
    </div>
    {% endif %}
</div>

{# ── Destinations de relai ─────────────────────────────────────────────── #}
<div class="card card-table">
    <div class="card-header justify-content-between">
        <span><i class="bi bi-arrow-repeat"></i> Destinations de relai S2S</span>
        <button class="btn btn-primary btn-xs" data-bs-toggle="collapse" data-bs-target="#addPostback">
            <i class="bi bi-plus-lg"></i> Ajouter</button>
    </div>

    <div class="collapse {{ postbacks is empty ? 'show' }}" id="addPostback">
        <div class="card-body border-bottom bg-body-tertiary">
            <p class="text-muted small">
                Le money site n'appelle qu'une URL — la nôtre. C'est ici qu'on démultiplexe vers les plateformes externes.
                Brancher une plateforme ne demande aucune ligne de code : un template et des macros suffisent.
            </p>
            <form method="post" action="/app/campaigns/{{ campaign.campaign_id }}/postback" class="row g-2">
                <input type="hidden" name="csrf" value="{{ csrf_token }}">
                <input type="hidden" name="cpb_id" id="cpb_id" value="">
                <div class="col-md-3">
                    <label class="form-label" for="cpb_name">Nom</label>
                    <input class="form-control" id="cpb_name" name="cpb_name" required placeholder="Plateforme externe">
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="cpb_method">Méthode</label>
                    <select class="form-select" id="cpb_method" name="cpb_method">
                        <option value="GET">GET</option><option value="POST">POST</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="cpb_on_status">Statuts déclencheurs</label>
                    <input class="form-control" id="cpb_on_status" name="cpb_on_status" value="approved"
                           placeholder="approved,chargeback">
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="cpb_success_pattern">Motif de succès (regex)</label>
                    <input class="form-control font-monospace" id="cpb_success_pattern" name="cpb_success_pattern"
                           placeholder="vide = seul le code HTTP compte">
                </div>
                <div class="col-12">
                    <label class="form-label" for="cpb_url">URL de relai</label>
                    <div class="input-group">
                        <input class="form-control font-monospace" id="cpb_url" name="cpb_url" required
                               placeholder="https://plateforme.com/postback?cid={external_clickid}&amp;sum={payout}&amp;status={status}">
                        <button class="btn btn-outline-secondary" type="button" id="previewBtn">Prévisualiser</button>
                    </div>
                    <div class="form-text">
                        <span class="d-block mb-1">Macros disponibles — cliquez pour insérer au curseur :</span>
                        {% for m in macros %}<code class="me-1 macro-chip" role="button" data-macro="{{ '{' ~ m ~ '}' }}">{{ '{' ~ m ~ '}' }}</code>{% endfor %}
                    </div>
                    <div id="previewOut" class="mt-2 small"></div>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Enregistrer la destination</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead><tr><th>Nom</th><th>URL</th><th>Méthode</th><th>Sur statut</th><th>Statut</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        {% for pb in postbacks %}
            <tr>
                <td class="fw-semibold">{{ pb.cpb_name }}
                    {% if pb.publisher_name %}<br><span class="badge text-bg-info">{{ pb.publisher_name }}</span>{% endif %}
                </td>
                <td><code class="small text-break">{{ pb.cpb_url }}</code></td>
                <td>{{ pb.cpb_method }}</td>
                <td><code>{{ pb.cpb_on_status }}</code></td>
                <td><span class="badge text-bg-{{ pb.cpb_status == 'active' ? 'success' : 'warning' }}">{{ pb.cpb_status }}</span></td>
                <td class="text-end text-nowrap">
                    <form method="post" action="/app/campaigns/{{ campaign.campaign_id }}/postback/{{ pb.cpb_id }}/toggle" class="d-inline">
                        <input type="hidden" name="csrf" value="{{ csrf_token }}">
                        <button class="btn btn-outline-secondary btn-xs" type="submit">{{ pb.cpb_status == 'active' ? 'Suspendre' : 'Activer' }}</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">
                {% include 'partials/_empty.html.twig' with {
                    'icon': 'arrow-repeat',
                    'title': 'Aucune destination de relai',
                    'text': "Les conversions de cette campagne seront enregistrées, mais relayées nulle part : aucune plateforme externe n'en sera informée. Ajoutez une destination avec son template d'URL à macros."
                } only %}
            </td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>

{# ── Générateur de lien publisher ──────────────────────────────────────── #}
<div class="modal fade" id="genLien" tabindex="-1" aria-labelledby="genLienTitre" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="genLienTitre">Composer le lien</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">

        <p class="text-muted small">
          Pour <strong id="genPublisher">—</strong>. Le lien fonctionne déjà sans rien ajouter :
          le token porte le couple campagne × publisher. Tout ce qui suit est facultatif.
        </p>

        <div class="mb-3">
          <label class="form-label" for="genCid">
            Identifiant de clic de la plateforme <span class="text-muted fw-normal">(cid)</span>
          </label>
          <input class="form-control font-monospace" id="genCid" placeholder="{clickid}">
          <div class="form-text">
            <strong>C'est le paramètre qui compte.</strong> Sans lui on peut signaler une
            conversion au publisher, mais pas lui dire laquelle. Mettez ici la macro de sa
            plateforme — souvent <code>{clickid}</code>, <code>##CLICKID##</code> ou
            <code>[SUBID]</code> : elle sera remplacée au moment du clic, chez lui.
          </div>
        </div>

        <div class="row g-2 mb-3">
          {% for i in 1..5 %}
          <div class="col-6 col-md-4">
            <label class="form-label small" for="genS{{ i }}">s{{ i }}</label>
            <input class="form-control form-control-sm font-monospace gen-sub" id="genS{{ i }}"
                   data-param="s{{ i }}" placeholder="libre">
          </div>
          {% endfor %}
        </div>
        <p class="form-text mt-0 mb-3">
          Cinq valeurs libres que le publisher choisit — source, créa, liste. Restituées telles
          quelles dans le reporting, et relayables par macro.
        </p>

        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" id="genPrefill">
          <label class="form-check-label" for="genPrefill">
            Ajouter les douze champs du kit mailing
          </label>
        </div>
        <p class="form-text mt-0">
          Ajoute <code>{% for p, m in prefill_fields %}{{ p }}=[{{ m }}]{{ not loop.last ? '&' }}{% endfor %}</code>.
          Ce sont les jetons que le routeur d'emailing du publisher remplace par les
          coordonnées du destinataire, pour que le formulaire du money site s'affiche
          déjà rempli. <strong>Ces valeurs ne sont jamais enregistrées</strong> par Vigil.
        </p>

        <hr>

        <label class="form-label" for="genOut">Lien à transmettre</label>
        <textarea class="form-control font-monospace" id="genOut" rows="4" readonly
                  aria-label="Lien composé"></textarea>
      </div>
      <div class="modal-footer justify-content-between">
        <span class="small text-muted" id="genNote"></span>
        <div>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
          <button type="button" class="btn btn-primary copy-btn" id="genCopier" data-copy="">
            <i class="bi bi-clipboard"></i> Copier
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script>
// Prévisualisation : résout les macros SANS appeler la destination. On regarde
// l'URL à l'œil avant d'envoyer quoi que ce soit chez un partenaire.
document.getElementById('previewBtn')?.addEventListener('click', async () => {
    const out = document.getElementById('previewOut');
    const body = new URLSearchParams({ csrf: '{{ csrf_token }}', url: document.getElementById('cpb_url').value });
    const res = await fetch('/app/campaigns/postback-preview', { method: 'POST', body });
    const data = await res.json();
    out.innerHTML = '<div class="alert alert-secondary py-2 mb-0"><strong>URL résolue :</strong><br>'
        + '<code class="text-break">' + data.url.replace(/</g, '&lt;') + '</code>'
        + (data.unknown.length ? '<div class="text-danger mt-1">Macros inconnues : ' + data.unknown.join(', ') + '</div>' : '')
        + '</div>';
});

// ── Générateur de lien publisher ────────────────────────────────────────────
(function () {
    const modal = document.getElementById('genLien');
    if (!modal) { return; }

    const KIT = {{ prefill_fields|json_encode|raw }};

    const out    = document.getElementById('genOut');
    const copier = document.getElementById('genCopier');
    const note   = document.getElementById('genNote');
    const cid    = document.getElementById('genCid');
    const kitOn  = document.getElementById('genPrefill');
    const subs   = Array.from(document.querySelectorAll('.gen-sub'));
    let   base   = '';

    // Une macro de plateforme ([PRENOM], {clickid}, ##CID##) doit arriver
    // INTACTE chez l'expéditeur : c'est lui qui la remplace. L'encoder la
    // rendrait méconnaissable, et le lien partirait avec un %5BPRENOM%5D
    // littéral dans l'e-mail. On encode donc, puis on rétablit les délimiteurs.
    const encoder = (v) => encodeURIComponent(v)
        .replace(/%5B/g, '[').replace(/%5D/g, ']')
        .replace(/%7B/g, '{').replace(/%7D/g, '}')
        .replace(/%23/g, '#');

    function composer() {
        const parts = [];
        if (cid.value.trim() !== '') { parts.push('cid=' + encoder(cid.value.trim())); }
        subs.forEach((el) => {
            if (el.value.trim() !== '') { parts.push(el.dataset.param + '=' + encoder(el.value.trim())); }
        });
        if (kitOn.checked) {
            Object.keys(KIT).forEach((champ) => parts.push(champ + '=[' + KIT[champ] + ']'));
        }

        const url = base + (parts.length ? '?' + parts.join('&') : '');
        out.value = url;
        copier.dataset.copy = url;

        // Un `#` non encodé ouvre le fragment : tout ce qui suit ne quitte
        // jamais le navigateur, et le paramètre arrive VIDE. C'est acceptable
        // pour une macro (##CID##), que la plateforme remplace avant l'envoi —
        // pas pour une valeur figée. On le dit, plutôt que de laisser le lien
        // se tronquer en silence au premier clic.
        if (url.indexOf('#') !== -1) {
            note.innerHTML = '<span class="text-warning">Ce lien contient un <code>#</code> :'
                + ' ce ne peut être qu\'une macro remplacée par la plateforme AVANT l\'envoi.'
                + ' Figée, la valeur arriverait vide.</span>';
        } else if (cid.value.trim() === '') {
            note.innerHTML = '<span class="text-warning">Sans <code>cid</code>, '
                + 'aucune conversion ne pourra lui être rattachée.</span>';
        } else {
            note.textContent = parts.length + ' paramètre(s)';
        }
    }

    modal.addEventListener('show.bs.modal', (e) => {
        const btn = e.relatedTarget;
        if (!btn) { return; }
        base = btn.dataset.lien;
        document.getElementById('genPublisher').textContent = btn.dataset.publisher;
        composer();
    });

    [cid, kitOn].concat(subs).forEach((el) => {
        el.addEventListener('input', composer);
        el.addEventListener('change', composer);
    });
})();
</script>
{% endblock %}
