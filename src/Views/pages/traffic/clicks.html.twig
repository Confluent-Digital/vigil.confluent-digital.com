{% extends 'layouts/base.html.twig' %}
{% block title %}Clics{% endblock %}
{% block content %}
<div class="page-head">
    <div>
        <h1 class="page-title">Clics</h1>
        <div class="page-sub">{{ clicks|length }} ligne(s) affichée(s) · heures en Europe/Paris</div>
    </div>
    <form class="filter-bar" method="get">
        <label class="filter">
            <span class="filter-label">Campagne</span>
            <select class="form-select form-select-sm" name="campaign" onchange="this.form.submit()"
                    aria-label="Filtrer par campagne">
                <option value="">Toutes les campagnes</option>
                {% for c in campaigns %}
                    <option value="{{ c.campaign_id }}" {{ app_campaign|default('') == c.campaign_id ? 'selected' }}>{{ c.campaign_name }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="filter">
            <span class="filter-label">Période</span>
            <select class="form-select form-select-sm" name="days" onchange="this.form.submit()"
                    aria-label="Filtrer par période">
                {% for d in [1, 7, 14, 31] %}<option value="{{ d }}" {{ days == d ? 'selected' }}>{{ d }} j</option>{% endfor %}
            </select>
        </label>
    </form>
</div>

<p class="screen-note">
    Écran d'investigation : lecture directe de <code>t_click</code>, bornée aux {{ days }} derniers jours
    et aux {{ limit }} dernières lignes. Pour du reporting, utilisez les statistiques agrégées.
</p>

<div class="card card-table">
<div class="table-responsive table-scroll">
<table class="table table-sm table-hover mb-0">
    <thead><tr>
        <th>Date</th><th>Clickid</th><th>Campagne</th><th>Publisher</th>
        <th>Click id externe</th><th>Sub1</th><th>IP</th><th class="text-end">Conv.</th><th>Signaux</th>
    </tr></thead>
    <tbody>
    {% for c in clicks %}
        <tr class="{{ c.click_is_bot ? 'opacity-50' }}">
            <td class="text-nowrap">{{ c.click_date|paris('d/m H:i:s') }}</td>
            <td><code class="small">{{ c.click_ulid }}</code></td>
            <td>{{ c.campaign_name }}</td>
            <td>{{ c.publisher_name }}</td>
            <td>{% if c.click_external_id %}<code class="small">{{ c.click_external_id }}</code>{% else %}<span class="text-muted">—</span>{% endif %}</td>
            <td>{{ c.click_sub1|default('—') }}</td>
            <td class="text-muted small">{{ c.ip|default('—') }}</td>
            <td class="text-end">{% if c.nb_conversions > 0 %}<span class="badge text-bg-success">{{ c.nb_conversions }}</span>{% else %}<span class="text-muted">—</span>{% endif %}</td>
            <td class="text-nowrap">
                {% if c.click_is_bot %}<span class="badge text-bg-secondary" title="Enregistré et redirigé normalement — jamais bloqué">bot</span>{% endif %}
                {% if not c.click_is_unique %}<span class="badge text-bg-light text-dark" title="Même IP et même user-agent qu'un clic des 24 h précédentes">répété</span>{% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="9">
            {% include 'partials/_empty.html.twig' with {
                'icon': 'cursor',
                'title': 'Aucun clic sur la période',
                'text': "Un clic n'apparaît ici que si un lien de tracking a été ouvert. Vérifiez qu'un publisher a bien un lien actif sur une campagne active, ou élargissez la période.",
                'cta_url': '/app/campaigns',
                'cta_label': 'Vérifier les liens de campagne',
                'cta_icon': 'link-45deg'
            } only %}
        </td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
</div>
{% endblock %}
